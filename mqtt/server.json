{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.nagarjunr/mqtt",
  "title": "MQTT",
  "description": "MCP server for MQTT 5.0 brokers (publish, subscribe, topic discovery).",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/nagarjunr/iot-mcp-servers",
    "source": "github",
    "subfolder": "mqtt"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "mqtt5-mcp-server",
      "version": "0.1.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MQTT_HOST",
          "description": "Broker hostname or IP",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "MQTT_PORT",
          "description": "Broker port, default 1883 (or 8883 for TLS)",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "MQTT_USERNAME",
          "description": "Broker username",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "MQTT_PASSWORD",
          "description": "Broker password",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "MQTT_USE_TLS",
          "description": "true/false, default false",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
